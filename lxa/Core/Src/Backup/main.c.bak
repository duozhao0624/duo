#include <string.h>
#include <stdio.h>
#include "OLED.h"
/* USER CODE END Includes */

/* Private typedef -----------------------------------------------------------*/
/* USER CODE BEGIN PTD */

/* USER CODE END PTD */

/* Private define ------------------------------------------------------------*/
/* USER CODE BEGIN PD */
#define RX_BUF_SIZE  32
/* USER CODE END PD */

/* Private macro -------------------------------------------------------------*/
/* USER CODE BEGIN PM */

/* USER CODE END PM */

/* Private variables ---------------------------------------------------------*/

/* USER CODE BEGIN PV */

uint8_t  g_run  = 1;
uint8_t  g_dir  = 0;
uint16_t g_step = 300;
uint8_t  g_led  = 0;
uint32_t g_last_tick = 0;

uint8_t  g_led_display = 0;
uint32_t g_oled_tick   = 0;

uint8_t  g_dir_key_last = 1;
uint8_t  g_run_key_last = 1;
uint32_t g_dir_tick = 0;
uint32_t g_run_tick = 0;
uint8_t  g_dir_wait = 0;
uint8_t  g_run_wait = 0;

uint8_t  g_rx_byte = 0;
uint8_t  g_rx_buf[RX_BUF_SIZE];
uint8_t  g_rx_len = 0;
uint8_t  g_pkt_ok = 0;
uint32_t g_rx_count = 0;

char     g_txt[32];

uint8_t  preset_run[4]  = {1, 1, 0, 0};
uint8_t  preset_dir[4]  = {0, 1, 0, 1};
uint16_t preset_step[4] = {300, 500, 300, 500};
uint8_t  preset_led[4]  = {0, 1, 2, 0};

/* USER CODE END PV */

/* Private function prototypes -----------------------------------------------*/
void SystemClock_Config(void);
/* USER CODE BEGIN PFP */
void led_show(uint8_t i);
void oled_update(void);
void oled_full_update(void);
void key_scan(void);
void app_tick(void);
void apply_packet(void);
void start_uart_receive(void);
void uart_send_str(char *s);
void uart_send_state(void);
/* USER CODE END PFP */

/* Private user code ---------------------------------------------------------*/
/* USER CODE BEGIN 0 */

void led_show(uint8_t i)
{
    HAL_GPIO_WritePin(GPIOA, GPIO_PIN_1 | GPIO_PIN_2 | GPIO_PIN_3, GPIO_PIN_RESET);

    if (i == 0)      HAL_GPIO_WritePin(GPIOA, GPIO_PIN_1, GPIO_PIN_SET);
    else if (i == 1) HAL_GPIO_WritePin(GPIOA, GPIO_PIN_2, GPIO_PIN_SET);
    else if (i == 2) HAL_GPIO_WritePin(GPIOA, GPIO_PIN_3, GPIO_PIN_SET);
}

void oled_update(void)
{
    uint8_t led_val;

    if (g_led > 2) g_led = 0;
    led_val = g_led + 1;

    OLED_ShowString(1, 1, "STATE:");
    if (g_run == 1) OLED_ShowString(1, 7, "RUN ");
    else            OLED_ShowString(1, 7, "STOP");

    OLED_ShowString(2, 1, "DIR:");
    if (g_dir == 0) OLED_ShowString(2, 5, "FWD ");
    else            OLED_ShowString(2, 5, "REV ");

    OLED_ShowString(3, 1, "STEP:");
    OLED_ShowNum(3, 6, g_step, 4);
    OLED_ShowString(3, 10, "ms");

    OLED_ShowString(4, 1, "LED:");
    OLED_ShowNum(4, 5, (uint32_t)led_val, 1);

    OLED_ShowNum(4, 9, g_rx_count, 3);
}

void oled_full_update(void)
{
    OLED_Clear();
    oled_update();
}

void key_scan(void)
{
    uint8_t dir_now = HAL_GPIO_ReadPin(GPIOA, GPIO_PIN_4);
    uint8_t run_now = HAL_GPIO_ReadPin(GPIOA, GPIO_PIN_5);

    if (g_dir_key_last == 1 && dir_now == 0 && g_dir_wait == 0)
    {
        g_dir_wait = 1;
        g_dir_tick = HAL_GetTick();
    }
    if (g_dir_wait == 1 && (HAL_GetTick() - g_dir_tick >= 20))
    {
        if (HAL_GPIO_ReadPin(GPIOA, GPIO_PIN_4) == 0)
        {
            if (g_dir == 0) g_dir = 1;
            else g_dir = 0;
            oled_full_update();
            uart_send_state();
        }
        g_dir_wait = 0;
    }
    g_dir_key_last = dir_now;

    if (g_run_key_last == 1 && run_now == 0 && g_run_wait == 0)
    {
        g_run_wait = 1;
        g_run_tick = HAL_GetTick();
    }
    if (g_run_wait == 1 && (HAL_GetTick() - g_run_tick >= 20))
    {
        if (HAL_GPIO_ReadPin(GPIOA, GPIO_PIN_5) == 0)
        {
            if (g_run == 1) g_run = 0;
            else g_run = 1;
            oled_full_update();
            uart_send_state();
        }
        g_run_wait = 0;
    }
    g_run_key_last = run_now;
}

void app_tick(void)
{
    uint32_t now = HAL_GetTick();

    if (g_run == 1 && (now - g_last_tick >= g_step))
    {
        g_last_tick = now;

        if (g_dir == 0)
        {
            g_led++;
            if (g_led > 2) g_led = 0;
        }
        else
        {
            if (g_led == 0) g_led = 2;
            else g_led--;
        }
    }
    led_show(g_led);

    if (now - g_oled_tick >= 500)
    {
        g_oled_tick = now;
        g_led_display = g_led;
        oled_update();
    }
}

void start_uart_receive(void)
{
    HAL_UART_Receive_IT(&huart1, &g_rx_byte, 1);
}

void uart_send_str(char *s)
{
    HAL_UART_Transmit(&huart1, (uint8_t *)s, strlen(s), 100);
}

void uart_send_state(void)
{
    sprintf(g_txt, "RUN=%d DIR=%d STEP=%d LED=%d\r\n",
            g_run, g_dir, g_step, g_led + 1);
    uart_send_str(g_txt);
}

void apply_packet(void)
{
    uint8_t cmd = g_rx_buf[1];

    if (cmd >= 0x01 && cmd <= 0x04)
    {
        uint8_t idx = cmd - 1;
        g_run  = preset_run[idx];
        g_dir  = preset_dir[idx];
        g_step = preset_step[idx];
        g_led  = preset_led[idx];
        g_led_display = g_led;
        oled_full_update();
        uart_send_str("CMD OK\r\n");
        uart_send_state();
    }
    else
    {
        uart_send_str("CMD ERR\r\n");
    }
}

void HAL_UART_RxCpltCallback(UART_HandleTypeDef *huart)
{
    uint8_t i;
    uint8_t sum = 0;

    if (huart->Instance != USART1) return;

    g_rx_count++;

    if (g_rx_byte == 0xAA)
    {
        g_rx_len = 0;
    }

    if (g_rx_len < RX_BUF_SIZE)
    {
        g_rx_buf[g_rx_len] = g_rx_byte;
        g_rx_len++;
    }

    if (g_rx_len >= 6)
    {
        for (i = 0; i < 5; i++)
        {
            sum += g_rx_buf[i];
        }
        if (sum == g_rx_buf[5])
        {
            g_pkt_ok = 1;
        }
        g_rx_len = 0;
    }

    HAL_UART_Receive_IT(&huart1, &g_rx_byte, 1);
}

/* USER CODE END 0 */

/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{

  /* USER CODE BEGIN 1 */

  /* USER CODE END 1 */

  /* MCU Configuration--------------------------------------------------------*/

  /* Reset of all peripherals, Initializes the Flash interface and the Systick. */
  HAL_Init();

  /* USER CODE BEGIN Init */

  /* USER CODE END Init */

  /* Configure the system clock */
  SystemClock_Config();

  /* USER CODE BEGIN SysInit */

  /* USER CODE END SysInit */

  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  MX_USART1_UART_Init();
  /* USER CODE BEGIN 2 */
  OLED_Init();
  led_show(g_led);
  g_last_tick = HAL_GetTick();
  g_oled_tick = HAL_GetTick();
  g_led_display = g_led;
  oled_full_update();
  start_uart_receive();
  uart_send_str("START\r\n");
  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
  while (1)
  {
    key_scan();
    app_tick();

    if (g_pkt_ok == 1)
    {
        g_pkt_ok = 0;
        apply_packet();
    }

    /* USER CODE END WHILE */

    /* USER CODE BEGIN 3 */
  }
  /* USER CODE END 3 */
}

